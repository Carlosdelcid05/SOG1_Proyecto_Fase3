# ── Odoo ─────────────────────────────────────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=Trebol4Devop
ODOO_API_LOGIN=ecommerce_api
ODOO_API_PASSWORD=TrebolApi2026!
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=admin

# ── Bridge (integracion Wix <-> Odoo) ───────────────────────────────
PORT=4000
BRIDGE_API_KEY=trebol-bridge-dev-key
PORTAL_TOKEN_SECRET=trebol-portal-dev-secret
PORTAL_ACCESS_CODE=trebol2026
# `make start` la actualiza con la URL del túnel. Si usas una URL fija
# (Tailscale/ngrok/Cloudflare Named Tunnel/VPS), ponla aquí y ejecuta
# `STABLE_URL=https://... make start`.
BRIDGE_PUBLIC_URL=http://localhost:4000
DEMO_MODE=true

# ── Wix ──────────────────────────────────────────────────────────────
WIX_SITE_URL=https://tu-sitio.wixsite.com/trebol4devop

# ── Metabase (perfil bi) ─────────────────────────────────────────────
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_PORT=5432
MB_DB_USER=odoo
MB_DB_PASS=odoo
MB_DB_HOST=db
