export async function getProfile() {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/profile", {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

export async function updateProfile(profile) {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/profile", {
    method: "PUT",
    body: profile,
    memberEmail: email,
  });
  return response.data;
}

export async function getPdfUrl(type, id) {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/pdf-token", {
    body: { type, id },
    memberEmail: email,
  });
  return response.data.url;
}

export async function getCatalog() {
  const response = await callBridge("/api/catalog", { method: "GET" });
  return response.data;
}

export async function requestQuote(form) {
  const email = await currentEmail();
  const response = await callBridge("/api/wix/quote-request", {
    body: { ...form, email: form.email || email },
  });
  return response;
}

/**
 * Construye la URL del checkout propio (bridge) a partir del carrito Velo.
 * El checkout se abre fuera de Wix para no depender del plan Premium.
 */
export async function getCheckoutUrl(items, backUrl = "") {
  if (!Array.isArray(items) || !items.length) {
    throw new Error("El carrito está vacío.");
  }

  const baseUrl = await getBridgePublicUrl();
  const encodedItems = items
    .map((item) => `${encodeURIComponent(item.sku)}:${Number(item.quantity) || 1}`)
    .join(",");

  const params = [`items=${encodedItems}`];
  if (backUrl) {
    params.push(`back=${encodeURIComponent(backUrl)}`);
  }

  return `${baseUrl}/checkout?${params.join("&")}`;
}
