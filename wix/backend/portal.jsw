// backend/portal.jsw
// Funciones que consumen las páginas del portal de clientes.

import { currentMember } from "wix-members-backend";
import { callBridge, getBridgePublicUrl } from "./bridge";

async function currentEmail() {
  try {
    const member = await currentMember.getMember({ fieldsets: ["FULL"] });
    return (
      member?.loginEmail ||
      member?.contactDetails?.emails?.[0] ||
      ""
    );
  } catch (error) {
    return "";
  }
}

async function memberEmailOrThrow() {
  const email = await currentEmail();
  if (!email) {
    throw new Error("Debes iniciar sesión para acceder a tu cuenta.");
  }
  return email;
}

export async function getSummary() {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/summary", {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

export async function getQuotes() {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/quotes", {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

export async function getQuoteDetail(id) {
  const email = await memberEmailOrThrow();
  const response = await callBridge(`/api/portal/quotes/${id}`, {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

export async function acceptQuote(id) {
  const email = await memberEmailOrThrow();
  const response = await callBridge(`/api/portal/quotes/${id}/accept`, {
    body: {},
    memberEmail: email,
  });
  return response.data;
}

export async function getOrders() {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/orders", {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

