export async function getInvoices() {
  const email = await memberEmailOrThrow();
  const response = await callBridge("/api/portal/invoices", {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
}

export async function getInvoiceDetail(id) {
  const email = await memberEmailOrThrow();
  const response = await callBridge(`/api/portal/invoices/${id}`, {
    method: "GET",
    memberEmail: email,
  });
  return response.data;
